# StockFlow Environment Variables Example
# Copy this file to .env and adjust values for your local environment

# Database Configuration (XAMPP MySQL)
# For local host execution: localhost
# For Docker container execution connecting to host XAMPP: host.docker.internal
DB_HOST=localhost
DB_PORT=3306
DB_NAME=stockflow_db
DB_USERNAME=root
DB_PASSWORD=

# Backend Server Configuration
SERVER_PORT=8085

# Frontend Configuration
VITE_API_BASE_URL=http://localhost:8085/api
